{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "CapstoneAPI": "Debug"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Database=capstone_db;Username=postgres;Password=postgres"
    },
    "Python": {
        "ScriptPath": "../Capstone.Infrastructure/Python/python_worker.py",
        "DefaultTimeout": 5
    },
    "CodeExecution": {
        "MaxCodeLength": 10000,
        "MaxExecutionTime": 30
    },
    "Jwt": {
        "Key": "secret-key",
        "Issuer": "Coopers.Capstone.API",
        "Audience": "Coopers.Capstone.API",
        "ExpirationMinutes": 30
    }
}